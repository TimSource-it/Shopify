<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_shopify" model="ir.ui.view">
        <field name="name">product.template.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Shopify" name="shopify">
                    <group>
                        <group string="Shopify Settings">
                            <field name="shopify_published"/>
                            <field name="shopify_tags"/>
                        </group>
                        <group string="Shopify Status">
                            <field name="shopify_product_id" readonly="1"/>
                            <field name="shopify_sync_status" readonly="1"/>
                            <field name="shopify_last_sync" readonly="1"/>
                            <field name="shopify_sync_error" readonly="1"
                                   invisible="not shopify_sync_error"/>
                        </group>
                    </group>
                    <group string="Shopify Inventory per Location">
                        <field name="shopify_inventory_html" widget="html" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Shopify Description">
                        <field name="shopify_description" widget="html"/>
                    </group>
                    <button name="action_sync_to_shopify"
                            string="Sync to Shopify"
                            type="object"
                            class="btn-primary"
                            invisible="not shopify_published and not shopify_product_id"/>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_shopify_sync_products" model="ir.actions.server">
        <field name="name">Sync to Shopify</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
for record in records:
    env['shopify.sync'].sync_product_to_shopify(record.id)
        </field>
    </record>
</odoo>
