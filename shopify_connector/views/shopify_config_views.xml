<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_config_form" model="ir.ui.view">
        <field name="name">shopify.config.form</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_oauth"
                            string="Verbind met Shopify"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_test_connection"
                            string="Test verbinding"
                            type="object"/>
                    <button name="action_import_orders"
                            string="Importeer bestellingen"
                            type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <group string="Winkelinstellingen">
                        <field name="shop_name"/>
                        <field name="shop_url"/>
                    </group>
                    <group string="OAuth Inloggegevens">
                        <field name="client_id"/>
                        <field name="client_secret" password="True"/>
                        <field name="access_token" password="True"/>
                    </group>
                    <group string="Synchronisatie">
                        <field name="sync_products"/>
                        <field name="sync_orders"/>
                        <field name="sync_inventory"/>
                        <field name="sync_customers"/>
                        <field name="allow_backorder"/>
                        <field name="pricelist_id"/>
                        <field name="published_scope"/>
                    </group>
                    <group string="Laatste synchronisaties">
                        <field name="last_order_sync" readonly="1"/>
                        <field name="last_product_sync" readonly="1"/>
                        <field name="last_inventory_sync" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_config_tree" model="ir.ui.view">
        <field name="name">shopify.config.tree</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="shop_name"/>
                <field name="shop_url"/>
                <field name="state"/>
                <field name="sync_products"/>
                <field name="sync_orders"/>
                <field name="last_order_sync"/>
            </list>
        </field>
    </record>

    <!-- Bestellingen overzicht -->
    <record id="action_shopify_orders" model="ir.actions.act_window">
        <field name="name">Shopify Bestellingen</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_order_id', '!=', False)]</field>
        <field name="context">{'search_default_shopify_orders': 1}</field>
    </record>

    <!-- Klanten overzicht -->
    <record id="action_shopify_customers" model="ir.actions.act_window">
        <field name="name">Shopify Klanten</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_customer_id', '!=', False)]</field>
    </record>

    <!-- Shopify bestellingen list view -->
    <record id="view_shopify_orders_list" model="ir.ui.view">
        <field name="name">sale.order.shopify.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-info">shopify_order_id != False and state == 'draft'</attribute>
            </list>
        </field>
    </record>

    <record id="action_shopify_config" model="ir.actions.act_window">
        <field name="name">Shopify Winkels</field>
        <field name="res_model">shopify.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu structuur -->
    <menuitem id="menu_shopify_root" name="Shopify" sequence="50"/>
    <menuitem id="menu_shopify_config" name="Instellingen" parent="menu_shopify_root"
              action="action_shopify_config" sequence="10"/>
    <menuitem id="menu_shopify_orders" name="Bestellingen" parent="menu_shopify_root"
              action="action_shopify_orders" sequence="20"/>
    <menuitem id="menu_shopify_customers" name="Klanten" parent="menu_shopify_root"
              action="action_shopify_customers" sequence="30"/>
</odoo>
