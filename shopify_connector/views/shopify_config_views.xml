<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_config_form" model="ir.ui.view">
        <field name="name">shopify.config.form</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Winkelinstellingen">
                        <field name="shop_name"/>
                        <field name="access_token" password="True"/>
                        <field name="active"/>
                    </group>
                    <group string="Synchronisatie">
                        <field name="sync_products"/>
                        <field name="sync_orders"/>
                        <field name="sync_inventory"/>
                        <field name="sync_customers"/>
                        <field name="allow_backorder"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_config_tree" model="ir.ui.view">
        <field name="name">shopify.config.tree</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="shop_name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_config" model="ir.actions.act_window">
        <field name="name">Shopify Winkels</field>
        <field name="res_model">shopify.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shopify_root" name="Shopify" sequence="50"/>
    <menuitem id="menu_shopify_config" name="Instellingen" parent="menu_shopify_root" action="action_shopify_config" sequence="10"/>
</odoo>
